root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.cs]
# C# style preferences.
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_expression_bodied_methods = when_possible:suggestion
csharp_style_expression_bodied_constructors = when_possible:suggestion
csharp_style_expression_bodied_properties = when_possible:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# Pattern Matching & Types
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion

# Formatting is owned by CSharpier (the only layout formatter; see ci.yml and CONTRIBUTING.md).
# CSharpier reads exactly these keys from here: indent_style, indent_size, end_of_line (all set
# in the [*] section above) and max_line_length below. The other entries in this block document
# CSharpier's non-configurable behaviors so this file stays the single source of style truth.
max_line_length = 100
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# IDE0055 is the Roslyn formatter's master switch. It drives `dotnet format whitespace`,
# EnforceCodeStyleInBuild, and editor "Format Document" — all of which disagree with CSharpier
# on layout (e.g. indentation of case bodies and pattern-matching arms). Killed here so no
# Roslyn-based formatter ever reindents CSharpier output.
dotnet_diagnostic.IDE0055.severity = none

# Naming Conventions
dotnet_naming_rule.interface_should_be_prefixed_with_i.severity = warning
dotnet_naming_rule.interface_should_be_prefixed_with_i.symbols = interface_symbols
dotnet_naming_rule.interface_should_be_prefixed_with_i.style = prefix_interface_with_i

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *

dotnet_naming_style.prefix_interface_with_i.required_prefix = I
dotnet_naming_style.prefix_interface_with_i.capitalization = pascal_case

dotnet_naming_rule.types_should_be_pascal_case.severity = warning
dotnet_naming_rule.types_should_be_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.type_symbols.applicable_accessibilities = *

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_should_be_camel_case.severity = warning
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_field_symbols
dotnet_naming_rule.private_fields_should_be_camel_case.style = prefix_field_with_underscore

dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_symbols.private_field_symbols.required_modifiers = 

dotnet_naming_style.prefix_field_with_underscore.required_prefix = _
dotnet_naming_style.prefix_field_with_underscore.capitalization = camel_case

# Meziantou.Analyzer configuration
# Silence overly pedantic style and metric rules, while preserving performance and correctness rules
dotnet_diagnostic.MA0004.severity = none # ConfigureAwait(false)
# Active audit: evaluate all other Meziantou performance and allocation rules
dotnet_diagnostic.MA0006.severity = none # Use string.Equals instead of == operator
dotnet_diagnostic.MA0016.severity = none # Prefer return collection abstraction
dotnet_diagnostic.MA0026.severity = none # To-do comments
dotnet_diagnostic.MA0048.severity = none # File name must match type name
dotnet_diagnostic.MA0051.severity = none # Method is too long

# Test projects analyzer configuration
[test/**.cs]
# xUnit quality analyzers
dotnet_diagnostic.xUnit1000.severity = warning
dotnet_diagnostic.xUnit1004.severity = warning
dotnet_diagnostic.xUnit1013.severity = warning
dotnet_diagnostic.xUnit1026.severity = warning
dotnet_diagnostic.xUnit2000.severity = warning
dotnet_diagnostic.xUnit2004.severity = warning
dotnet_diagnostic.xUnit2013.severity = warning
dotnet_diagnostic.xUnit2017.severity = warning

# Banned symbols analyzer (RS0030) - migrating xUnit.Assert to Shouldly (#295)
dotnet_diagnostic.RS0030.severity = warning

# Suppress test-irrelevant rules (ConfigureAwait, defensive null validation, uninstantiated test fixtures)
dotnet_diagnostic.CA2007.severity = none # ConfigureAwait is not needed in test runner execution context
dotnet_diagnostic.MA0004.severity = none # ConfigureAwait(false)
dotnet_diagnostic.CA1812.severity = none # Internal class never instantiated (test models and manifests)
dotnet_diagnostic.CA1062.severity = none # Validate parameter is non-null
dotnet_diagnostic.CA1031.severity = none # Do not catch generic Exception (negative testing)
dotnet_diagnostic.CA1822.severity = none # Mark members as static (test methods)
dotnet_diagnostic.CA1823.severity = none # Unused fields (test constants)

[benchmarks/**.cs]
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1031.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1823.severity = none

[samples/**.cs]
dotnet_diagnostic.category-Meziantou.severity = none
dotnet_diagnostic.CA2007.severity = none

# --------------------------------------------------------------------------------------------
# Code metrics and strict reliability gates (#251, docs/21-CODE-METRICS.md).
#
# Scoped to src/ deliberately. Test, benchmark, sample and tooling code is measured by nothing
# here: a table-driven test method with forty cases is not a maintainability problem, and gating
# it would train everyone to suppress the rule. The emitted code is held to the same bar as src/:
# analysis/*/obj/golden/ is the golden models' generated source (see the last section).
#
# `warning`, not `error`, matches the repository's stance in Directory.Build.props: warnings are
# not errors in local builds, and CI passes `-warnaserror` explicitly. These therefore fail CI
# exactly like every other analyzer rule here.
#
# Thresholds live in CodeMetricsConfig.txt at the repository root (an AdditionalFile on each src
# project), not here, because that is the only file these rules read.
# --------------------------------------------------------------------------------------------
[{src,analysis/*/obj/golden}/**.cs]
# Cyclomatic complexity per method.
dotnet_diagnostic.CA1502.severity = warning
# Maintainability index.
dotnet_diagnostic.CA1505.severity = warning
# Class coupling.
dotnet_diagnostic.CA1506.severity = warning

# Strict ConfigureAwait enforcement for library / generator code
dotnet_diagnostic.CA2007.severity = warning
dotnet_diagnostic.MA0004.severity = warning

# Attribute design rule tuning
dotnet_diagnostic.CA1019.severity = none # Allow property setters for named attribute arguments
dotnet_diagnostic.CA1008.severity = suggestion

# Rules that replace the SonarAnalyzer checks removed by docs/55-SONAR-REMOVAL.md. They share
# this section so the emitted code is held to them too.
dotnet_diagnostic.RCS1003.severity = warning # Brace a multi-line if-else body (was S2681)
dotnet_diagnostic.RCS1163.severity = warning # Unused parameter (was S1172)
dotnet_diagnostic.RCS1134.severity = warning # Redundant statement, e.g. a trailing return (was S3626)
dotnet_diagnostic.RCS1132.severity = warning # Override that only calls base (was S1185)
dotnet_diagnostic.RCS1249.severity = warning # Unnecessary null-forgiving operator (was S8969)
dotnet_diagnostic.MA0050.severity = warning # Validate arguments before the iterator (was S4456)
dotnet_diagnostic.MA0067.severity = warning # Guid.Empty over new Guid() (was S4581)
dotnet_diagnostic.CA1849.severity = warning # Async overload exists (was S6966)
dotnet_diagnostic.IDE0059.severity = warning # Unnecessary assignment (was S1854)

# --------------------------------------------------------------------------------------------
# Generated-code analysis (docs/50-GENERATED-CODE-ANALYSIS.md). analysis/*/obj/golden/ holds the
# golden models' emitted source, copied there by analysis/Directory.Build.targets, and shares the
# src/ section above. Roslyn classifies it as generated from its `.g.cs` name and
# `<auto-generated>` header, which stops every analyzer reporting on it; this undoes that.
# --------------------------------------------------------------------------------------------
[analysis/*/obj/golden/**.cs]
generated_code = false

# The replacements that fire in the emitted code today stay out of the gate (docs/55-SONAR-REMOVAL.md):
# RCS1003 reports 22 emitted if-else statements and RCS1249 one `null!` that is only redundant for a
# reference-type element. RCS1001 (S2681, the rule that fired in emitted code, #551) reports none, so it
# gates here; in src/ it reports 34 and stays at its default.
dotnet_diagnostic.RCS1001.severity = warning
dotnet_diagnostic.RCS1003.severity = suggestion
dotnet_diagnostic.RCS1249.severity = suggestion

# The model declarations the emitted code extends are scaffolding the analysis compiles with it,
# not output. They are not marked generated_code (that would also drop their nullable context).
[test/Parquet.SourceGenerator.Tests/GoldenModels/**.cs]
dotnet_analyzer_diagnostic.severity = none
