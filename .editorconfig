root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.cs]
# C# style preferences.
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_expression_bodied_methods = when_possible:suggestion
csharp_style_expression_bodied_constructors = when_possible:suggestion
csharp_style_expression_bodied_properties = when_possible:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# Pattern Matching & Types
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion

# Formatting is owned by CSharpier (the only layout formatter; see ci.yml and CONTRIBUTING.md).
# CSharpier reads exactly these keys from here: indent_style, indent_size, end_of_line (all set
# in the [*] section above) and max_line_length below. The other entries in this block document
# CSharpier's non-configurable behaviors so this file stays the single source of style truth.
max_line_length = 100
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# IDE0055 is the Roslyn formatter's master switch. It drives `dotnet format whitespace`,
# EnforceCodeStyleInBuild, and editor "Format Document" — all of which disagree with CSharpier
# on layout (e.g. indentation of case bodies and pattern-matching arms). Killed here so no
# Roslyn-based formatter ever reindents CSharpier output.
dotnet_diagnostic.IDE0055.severity = none

# Naming Conventions
dotnet_naming_rule.interface_should_be_prefixed_with_i.severity = warning
dotnet_naming_rule.interface_should_be_prefixed_with_i.symbols = interface_symbols
dotnet_naming_rule.interface_should_be_prefixed_with_i.style = prefix_interface_with_i

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *

dotnet_naming_style.prefix_interface_with_i.required_prefix = I
dotnet_naming_style.prefix_interface_with_i.capitalization = pascal_case

dotnet_naming_rule.types_should_be_pascal_case.severity = warning
dotnet_naming_rule.types_should_be_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.type_symbols.applicable_accessibilities = *

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_should_be_camel_case.severity = warning
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_field_symbols
dotnet_naming_rule.private_fields_should_be_camel_case.style = prefix_field_with_underscore

dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_symbols.private_field_symbols.required_modifiers = 

dotnet_naming_style.prefix_field_with_underscore.required_prefix = _
dotnet_naming_style.prefix_field_with_underscore.capitalization = camel_case

# Meziantou.Analyzer configuration
# Silence overly pedantic style and metric rules, while preserving performance and correctness rules
dotnet_diagnostic.MA0004.severity = none # ConfigureAwait(false)
dotnet_diagnostic.MA0006.severity = none # Use string.Equals instead of == operator
dotnet_diagnostic.MA0016.severity = none # Prefer return collection abstraction
dotnet_diagnostic.MA0026.severity = none # To-do comments
dotnet_diagnostic.MA0048.severity = none # File name must match type name
dotnet_diagnostic.MA0051.severity = none # Method is too long

# Disable analyzer in test projects
[test/**.cs]
dotnet_diagnostic.category-Meziantou.severity = none

[samples/**.cs]
dotnet_diagnostic.category-Meziantou.severity = none


