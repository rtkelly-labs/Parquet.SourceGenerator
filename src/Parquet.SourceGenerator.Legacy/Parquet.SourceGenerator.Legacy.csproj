<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Parquet.SourceGenerator.Legacy</RootNamespace>

        <DevelopmentDependency>true</DevelopmentDependency>

        <!--
      Turns on RS1035 (banned APIs in a compiler extension), RS1036, RS1038 (Workspaces reference)
      and RS1041 (target framework) for the assembly that ships in analyzers/dotnet/cs and loads
      into every consumer compiler (#471). Microsoft.CodeAnalysis.Analyzers supplies the rules;
      this property is what switches the generator-author subset on.
    -->
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

        <!--
      The generator ships ONLY as an analyzer, never as a library.
    -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <!--
      RS1032 (Microsoft.CodeAnalysis.Analyzers 5.x) wants a trailing period on ten multi-sentence
      messageFormat strings in DiagnosticDescriptors.cs. Fixing it changes user-visible diagnostic
      text and belongs to the emitter owners, so it is suppressed by name (#471), not by the RS1xxx
      range, which keeps the generator-author rules RS1035/RS1036/RS1038/RS1041 on. RS2008 (release
      tracking) is satisfied by the AnalyzerReleases files below (#593).
    -->
        <NoWarn>$(NoWarn);RS1032</NoWarn>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackBuildOutputs</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference
            Include="Microsoft.CodeAnalysis.CSharp"
            VersionOverride="4.0.1"
            PrivateAssets="all"
        />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Parquet.SourceGenerator.Attributes\Parquet.SourceGenerator.Attributes.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None
            Include="build/Parquet.SourceGenerator.Legacy.props"
            Pack="true"
            PackagePath="build/"
        />
    </ItemGroup>

    <ItemGroup>
        <Compile
            Include="..\Parquet.SourceGenerator\Diagnostics\*.cs"
            Link="Diagnostics\%(Filename)%(Extension)"
        />
        <Compile
            Include="..\Parquet.SourceGenerator\Models\*.cs"
            Link="Models\%(Filename)%(Extension)"
        />
        <Compile
            Include="..\Parquet.SourceGenerator\Parser\*.cs"
            Link="Parser\%(Filename)%(Extension)"
        />
        <Compile
            Include="..\Parquet.SourceGenerator\Emitter\Components\*.cs"
            Link="Emitter\Components\%(Filename)%(Extension)"
        />
        <Compile Include="..\Parquet.SourceGenerator\IsExternalInit.cs" Link="IsExternalInit.cs" />
    </ItemGroup>

    <Target Name="PackBuildOutputs">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>

    <!--
    PARQAPI002 (docs/18-API-CHANGE-CONTRACT.md). The gate is an analyzer, referenced build-time
    only: ReferenceOutputAssembly="false" keeps it out of the compile scope and PrivateAssets="all"
    keeps it out of the produced package. It short-circuits unless it is handed src/api/seams.txt,
    which only the projects in this ItemGroup supply.
  -->
    <ItemGroup>
        <ProjectReference
            Include="..\..\tools\Parquet.SourceGenerator.ApiGates\Parquet.SourceGenerator.ApiGates.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
            PrivateAssets="all"
        />
        <!-- CA1502 / CA1505 / CA1506 thresholds. See docs/21-CODE-METRICS.md. -->
        <AdditionalFiles Include="..\..\CodeMetricsConfig.txt" />
        <!-- Release tracking for the PARQ diagnostics (RS2000 series, #593); the shipped boundary is the v0.0.x tags. -->
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
        <AdditionalFiles Include="..\api\seams.txt" />
        <AdditionalFiles Include="..\..\docs\api\LEDGER.md" />
    </ItemGroup>
</Project>
