<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!--
            Coverage is collected and reported, but not yet gated.

            A hard 80% line+branch threshold has to be met by every pull request independently,
            so it blocks incremental work: a small, correct fix that adds a branch fails the gate
            on arithmetic rather than on merit. Restore a threshold once the suite covers the
            emitter, and ratchet it upward from the measured baseline rather than starting at a
            round number nothing has been checked against.
          -->
          <Exclude>[BenchmarkSummaryGenerator]*,[Parquet.SourceGenerator.Tests]*,[Parquet.SourceGenerator.CLI]*,[Parquet.SourceGenerator.AotTest]*,[Parquet.SourceGenerator.SampleAot]*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
