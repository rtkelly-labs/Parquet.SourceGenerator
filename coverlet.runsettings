<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!--
            Coverage is collected here and gated afterwards: ci.yml runs scripts/CoverageSummary.cs
            with --min-line 85.0 --min-branch 70.0 over the report this produces, and that step
            fails the `test` job (and so the required `build` check). See
            docs/51-CI-GATE-MATRIX.md for the known limits of that gate.
          -->
          <Exclude>[BenchmarkSummaryGenerator]*,[Parquet.SourceGenerator.Tests]*,[Parquet.SourceGenerator.CLI]*,[Parquet.SourceGenerator.AotTest]*,[Parquet.SourceGenerator.SampleAot]*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
