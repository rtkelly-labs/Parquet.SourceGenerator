<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
    </PropertyGroup>

    <ItemGroup>
        <!-- Roslyn Compiler & Analyzer Dependencies -->
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
        <PackageVersion Include="Meziantou.Analyzer" Version="3.0.290" />

        <!-- Runtime Dependencies -->
        <PackageVersion Include="Parquet.Net" Version="6.1.0" />
        <!--
      Apache.Arrow is pinned for the test assemblies only. Neither the generator nor the Attributes
      runtime package depends on it: the RecordBatch bridge is emitted only into compilations that
      already reference Apache.Arrow themselves (see ArrowBridgeEmitter). 23.0.0 is the documented
      support floor.
    -->
        <PackageVersion Include="Apache.Arrow" Version="23.0.0" />
        <PackageVersion Include="System.Memory" Version="4.6.3" />
        <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />

        <!-- Test Framework & Coverage Dependencies -->
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
        <PackageVersion Include="coverlet.collector" Version="10.1.0" />
        <PackageVersion Include="FsCheck.Xunit" Version="3.4.0" />
        <PackageVersion Include="Shouldly" Version="4.3.0" />
        <PackageVersion Include="Bogus" Version="35.6.5" />
        <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />

        <!-- Benchmarks & Tooling Dependencies -->
        <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
        <PackageVersion Include="CommandLineParser" Version="2.9.1" />
        <PackageVersion Include="System.Text.Json" Version="8.0.5" />
        <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
    </ItemGroup>
</Project>
