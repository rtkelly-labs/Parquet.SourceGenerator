{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rtkelly-labs/Parquet.SourceGenerator/diffra/schemas/test-results-payload.schema.json",
  "title": "Derived payload schema: diffra/test-results@1 for parquet-sourcegenerator",
  "description": "Derived by hand from diffra.project.yml, following Diffra's examples/project-file/test-results/payload.schema.json. Only scope, methodology and stratum differ; $defs/testResult is copied unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "methodology",
    "stratum",
    "plan",
    "metrics"
  ],
  "properties": {
    "scope": {
      "const": "parquet-sourcegenerator"
    },
    "methodology": {
      "const": "diffra/test-results@1;parquet-sourcegenerator.prototype.trx@0.1.0;trx@2010"
    },
    "stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "os",
        "arch"
      ],
      "properties": {
        "suite": {
          "enum": [
            "core",
            "abi",
            "external"
          ]
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests"
      ],
      "properties": {
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keys"
          ],
          "properties": {
            "keys": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "failed": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests"
      ],
      "properties": {
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "results"
          ],
          "properties": {
            "results": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "$ref": "#/$defs/testResult"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "testResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "duration"
          ],
          "properties": {
            "tag": {
              "const": "success"
            },
            "duration": {
              "type": "string",
              "pattern": "^(0|(0|[1-9][0-9]*)\\.[0-9]*[1-9]|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "duration",
            "kind",
            "message"
          ],
          "properties": {
            "tag": {
              "const": "error"
            },
            "duration": {
              "type": "string",
              "pattern": "^(0|(0|[1-9][0-9]*)\\.[0-9]*[1-9]|[1-9][0-9]*)$"
            },
            "kind": {
              "enum": [
                "assertion",
                "exception",
                "timeout"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag",
            "reason"
          ],
          "properties": {
            "tag": {
              "const": "skipped"
            },
            "reason": {
              "type": "string",
              "maxLength": 4096
            }
          }
        }
      ]
    }
  }
}
