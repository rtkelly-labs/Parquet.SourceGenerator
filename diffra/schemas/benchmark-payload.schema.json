{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rtkelly-labs/Parquet.SourceGenerator/diffra/schemas/benchmark-payload.schema.json",
  "title": "Derived payload schema: parquet-sourcegenerator, metric benchmarks",
  "description": "Derived by hand from diffra.project.yml, following Diffra's examples/project-file/benchmarks/payload.schema.json. Differences from that example are listed in README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "methodology",
    "stratum",
    "plan",
    "metrics"
  ],
  "properties": {
    "scope": {
      "const": "parquet-sourcegenerator"
    },
    "methodology": {
      "type": "string",
      "pattern": "^diffra/benchmark@1;parquet-sourcegenerator\\.prototype\\.benchmarkdotnet@0\\.1\\.0;benchmarkdotnet-json-full@[0-9]+\\.[0-9]+$"
    },
    "stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch",
        "runtime",
        "cpu"
      ],
      "properties": {
        "os": {
          "enum": [
            "linux",
            "macos",
            "windows"
          ]
        },
        "arch": {
          "enum": [
            "x64",
            "arm64"
          ]
        },
        "runtime": {
          "type": "string",
          "pattern": "^net[0-9]+\\.[0-9]+$"
        },
        "cpu": {
          "type": "string",
          "pattern": "^[^\\s](.*[^\\s])?$"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmarks"
      ],
      "properties": {
        "benchmarks": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmarks"
      ],
      "properties": {
        "benchmarks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allocatedBytes": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/caseKey"
              },
              "additionalProperties": {
                "$ref": "#/$defs/bytes"
              }
            },
            "gen0PerKOps": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/caseKey"
              },
              "additionalProperties": {
                "$ref": "#/$defs/perKOps"
              }
            },
            "gen1PerKOps": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/caseKey"
              },
              "additionalProperties": {
                "$ref": "#/$defs/perKOps"
              }
            },
            "gen2PerKOps": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/caseKey"
              },
              "additionalProperties": {
                "$ref": "#/$defs/perKOps"
              }
            },
            "meanTime": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/caseKey"
              },
              "additionalProperties": {
                "$ref": "#/$defs/duration"
              }
            }
          },
          "required": [
            "allocatedBytes",
            "gen0PerKOps",
            "gen1PerKOps",
            "gen2PerKOps",
            "meanTime"
          ]
        }
      }
    }
  },
  "$defs": {
    "caseKey": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*(\\(.*\\))?$"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/caseKey"
          }
        },
        "failed": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/caseKey"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "unit": {
          "const": "B"
        }
      }
    },
    "perKOps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^(0|(0|[1-9][0-9]*)\\.[0-9]*[1-9]|[1-9][0-9]*)$"
        },
        "unit": {
          "const": "count/1000-ops"
        }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^(0|(0|[1-9][0-9]*)\\.[0-9]*[1-9]|[1-9][0-9]*)$"
        },
        "unit": {
          "const": "ns"
        }
      }
    }
  }
}
