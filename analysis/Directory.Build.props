<Project>
    <!--
    Generated-code analysis (docs/50-GENERATED-CODE-ANALYSIS.md).

    Each project under analysis/ compiles the emitted source of the golden models, published by the
    test suite, together with the model declarations it extends, and runs every analyzer the
    shipped src/ projects run over it. Analyzers normally skip generated code; three switches undo
    that, and all three are needed:

      1. `generated_code = false` in .editorconfig for analysis/*/obj/golden/. Roslyn otherwise
         classifies the files as generated from their `.g.cs` name and `// <auto-generated />`
         header, and no NetAnalyzers, Meziantou or Roslynator rule reports on them.
      2. That path shares the src/ .editorconfig section, so the strict library rules (CA2007,
         MA0004, the CA1502/CA1505/CA1506 metric gates) apply exactly as they do to src/.
      3. SonarLint.xml: Sonar has its own generated-code recogniser that ignores (1).

    Not part of Parquet.SourceGenerator.slnx: the golden files do not exist until the test suite
    has published them, so these projects build after it, from scripts/GeneratedCodeAnalysis.cs.
  -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <!--
          Emitted code carries no `using` directives, and consumers need not enable implicit usings.
          The repository default (Directory.Build.props) enables them, which once let an unqualified
          `AsMemory` compile here and then fail in package consumption CI. Compile it bare, as it ships.
        -->
        <ImplicitUsings>disable</ImplicitUsings>
        <!-- Consumers publish the generated code with NativeAOT; run the trim/AOT analyzers on it. -->
        <IsAotCompatible>true</IsAotCompatible>
        <GoldenDirectory Condition="'$(GoldenDirectory)' == ''"
            >$(MSBuildThisFileDirectory)../artifacts/golden</GoldenDirectory>
        <GoldenCopyDirectory>$(MSBuildProjectDirectory)/obj/golden</GoldenCopyDirectory>
        <GoldenModelDirectory>$(MSBuildThisFileDirectory)../test/Parquet.SourceGenerator.Tests/GoldenModels</GoldenModelDirectory>

        <!--
      Every warning fails the build. GeneratedCodeBaseline.props is empty; see it for why that
      stays so. scripts/GeneratedCodeAnalysis.cs fails on any finding regardless.
    -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <Import Project="GeneratedCodeBaseline.props" />

    <ItemGroup>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)SonarLint.xml" />
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)../CodeMetricsConfig.txt" />
    </ItemGroup>
</Project>
