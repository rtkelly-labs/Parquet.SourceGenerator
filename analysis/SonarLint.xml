<?xml version="1.0" encoding="UTF-8"?>
<!--
  SonarAnalyzer skips generated code by its own recogniser (a `.g.cs` name or an `<auto-generated>`
  header), independently of the `generated_code = false` .editorconfig override that turns the
  Roslyn-based analyzers back on. This setting is the only thing that turns Sonar back on.
-->
<AnalysisInput>
    <Settings>
        <Setting>
            <Key>sonar.cs.analyzeGeneratedCode</Key>
            <Value>true</Value>
        </Setting>
    </Settings>
</AnalysisInput>
