<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!--
    <clear /> matters: without it the local feed is added alongside whatever sources the machine or
    CI image already has, and a package resolved from nuget.org could silently stand in for the one
    we just built. Restoring from an explicit, minimal source list is what makes a pass meaningful.
  -->
    <packageSources>
        <clear />
        <add key="local-artifacts" value="../../artifacts" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
</configuration>
