<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>Parquet.SourceGenerator.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Parquet.Net" />
        <!--
      Referencing Apache.Arrow here is what switches the generator's conditional Arrow bridge on for
      this assembly: the emitted overloads only exist because this reference does.
    -->
        <PackageReference Include="Apache.Arrow" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Bogus" />
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Parquet.SourceGenerator.Attributes\Parquet.SourceGenerator.Attributes.csproj" />
        <!--
      ReferenceOutputAssembly stays "true" here, unlike every other consumer in the repository.
      This project unit-tests the generator's internals directly (CodeEmitter, TargetParser,
      EquatableArray, DiagnosticInfo), so it genuinely needs the assembly as a compile reference in
      addition to running it as an analyzer. Consumers only need the generated output, and use
      "false".
    -->
        <ProjectReference
            Include="..\..\src\Parquet.SourceGenerator\Parquet.SourceGenerator.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="true"
        />
        <ProjectReference
            Include="..\..\src\Parquet.SourceGenerator.Legacy\Parquet.SourceGenerator.Legacy.csproj"
            ReferenceOutputAssembly="true"
            Aliases="LegacyGenerator"
        />
        <!--
      The benchmark regression check is the one piece of the performance story that can be verified
      without running benchmarks: unit parsing, threshold arithmetic and baseline round-tripping are
      ordinary logic. Testing them here means a broken gate fails the normal CI run rather than
      being discovered the next time someone dispatches the benchmark workflow.
    -->
        <ProjectReference Include="..\..\tools\BenchmarkSummaryGenerator\BenchmarkSummaryGenerator.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="GoldenModels\**\*.cs" />
        <None Include="GoldenModels\**\*.cs" />
    </ItemGroup>

    <!--
    The signature-only API renderer (docs/17-GENERATED-API-BASELINES.md) is shared with the
    ApiGates project rather than duplicated: GoldenCorpus uses it to derive each golden model's
    .api.txt, and the policy tests read that in memory.
  -->
    <ItemGroup>
        <Compile
            Include="..\..\tools\Parquet.SourceGenerator.ApiGates\GeneratedApiBaseline.cs"
            Link="GeneratedApiBaseline.cs"
        />
        <!--
      The catalogue reader and the escape-hatch matcher are subtle enough to deserve unit tests of
      their own, and an analyzer's internals are otherwise only reachable through a full
      compilation. Linked in for the same reason as the renderer above: one implementation.
    -->
        <Compile
            Include="..\..\tools\Parquet.SourceGenerator.ApiGates\ApiCatalogue.cs"
            Link="ApiCatalogue.cs"
        />
        <Compile
            Include="..\..\tools\Parquet.SourceGenerator.ApiGates\ApiLedger.cs"
            Link="ApiLedger.cs"
        />
        <AdditionalFiles Include="BannedSymbols.txt" />
    </ItemGroup>
</Project>
