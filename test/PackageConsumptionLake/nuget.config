<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!--
    As test/PackageConsumption, plus a second local feed: Lake.Parquet as just built by
    scripts/BuildLakeParquet.cs (artifacts/lake). <clear /> and source mapping make sure neither the generator nor
    Lake.Parquet can come from nuget.org instead of this run's build.
  -->
    <packageSources>
        <clear />
        <add key="local-artifacts" value="../../artifacts" />
        <add key="local-lake" value="../../artifacts/lake" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="local-artifacts">
            <package pattern="Parquet.SourceGenerator*" />
        </packageSource>
        <packageSource key="local-lake">
            <package pattern="Lake.Parquet" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
