<Project Sdk="Microsoft.NET.Sdk">
    <!--
    Deliberately NOT part of Parquet.SourceGenerator.slnx.

    Consumes Parquet.SourceGenerator.Legacy as a NuGet package built into ../../artifacts.
    Exercises Parquet.Net 4.25.0 on .NET 10 (and, in CI, the .NET 11 runtime) and .NET Framework 4.7.2.
  -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net10.0;net472</TargetFrameworks>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>PackageConsumptionLegacy</RootNamespace>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!--
      net472's default language version is 7.3, which predates switch expressions, `??=` and
      nullable reference annotations — all of which the generated code uses. Without this the
      net472 target cannot compile at all, which is the one target this package exists for.
    -->
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference
            Include="Parquet.SourceGenerator.Legacy"
            Version="$(GeneratorPackageVersion)"
        />
        <PackageReference Include="Parquet.Net" Version="4.25.0" />
        <!--
          Parquet.Net 4.25.0 pulls Snappier 1.1.6 and System.Text.Json 8.0.4, both with high
          severity advisories (GHSA-pggp-6c3x-2xmx, GHSA-8g4q-xg66-9fp4). The .NET 10 SDK audits
          transitive packages, so restore fails with NU1903 unless the patched versions are pinned
          here; this project opts out of central package management.
        -->
        <PackageReference Include="Snappier" Version="1.3.1" />
        <PackageReference Include="System.Text.Json" Version="8.0.5" />
    </ItemGroup>

    <!--
    Building a .NET Framework target on Linux needs the reference assemblies; the CI runner has no
    .NET Framework targeting pack installed. This only makes the target *buildable* — running it
    still requires Windows or Mono, so CI compiles net472 and executes net10.0.
  -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
        <PackageReference
            Include="Microsoft.NETFramework.ReferenceAssemblies"
            Version="1.0.3"
            PrivateAssets="all"
        />
    </ItemGroup>

    <ItemGroup>
        <!--
      Shared with test/PackageConsumption so both packages describe the same columns; that is
      what makes a file written by one readable by the other in CI's cross-version interop step.
    -->
        <Compile Include="..\CrossVersionInterop\InteropModels.cs" Link="InteropModels.cs" />
    </ItemGroup>
</Project>
