<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="local-artifacts" value="../../artifacts" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>

    <!--
      Package source mapping (#394): `Parquet.SourceGenerator*` may only come from the local feed of
      packages this run just built, so a published package of the same id can never stand in for
      the one under test; everything else comes from nuget.org. The most specific pattern wins.
    -->
    <packageSourceMapping>
        <packageSource key="local-artifacts">
            <package pattern="Parquet.SourceGenerator*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
